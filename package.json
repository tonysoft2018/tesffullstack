{
  "name": "frontend-orozco",
  "version": "0.0.0",
  "scripts": {
    "ng": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-with-node.ps1 ng",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-with-node.ps1 ng serve",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-with-node.ps1 ng build",
    "watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-with-node.ps1 ng build --watch --configuration development",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-with-node.ps1 ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.21",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
